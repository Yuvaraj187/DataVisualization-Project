      <aliases enabled='yes' />
      <column caption='Age Group' datatype='string' name='[Calculation.AgeGroup]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt;= 21 THEN &quot;Youth (&lt;=21)&quot;&#13;&#10;ELSEIF [age] &lt;= 29 THEN &quot;Prime (22-29)&quot;&#13;&#10;ELSE &quot;Veteran (30+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Overall Rating' datatype='real' name='[Calculation.AvgRating]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([overall_rating])' />
      </column>
      <column caption='Dynamic Metric Measure' datatype='real' name='[Calculation.DynamicMetric]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Total Market Value&quot; THEN [Calculation.TotalMarketValue]&#13;&#10;    WHEN &quot;Total Players&quot; THEN [Calculation.TotalPlayers]&#13;&#10;    WHEN &quot;International Rate&quot; THEN [Calculation.InternationalRate]&#13;&#10;    WHEN &quot;Average Overall Rating&quot; THEN [Calculation.AvgRating]&#13;&#10;END' />
      </column>
      <column caption='International Rate' datatype='real' default-format='p0.00%' name='[Calculation.InternationalRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation.IsInternational]) / [Calculation.TotalPlayers]' />
      </column>
      <column caption='Is International' datatype='integer' name='[Calculation.IsInternational]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([national_team]) THEN 0 ELSE 1 END' />
      </column>
      <column caption='Primary Position' datatype='string' name='[Calculation.PrimaryPosition]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([positions], &quot;,&quot;, 1)' />
      </column>
      <column caption='Total Market Value' datatype='integer' name='[Calculation.TotalMarketValue]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value_euro])' />
      </column>
      <column caption='Total Players' datatype='integer' name='[Calculation.TotalPlayers]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([name])' />
      </column>
      <column caption='Value Per Rating' datatype='real' name='[Calculation.ValuePerRating]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value_euro]) / SUM([overall_rating])' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
